# Names only. Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (local values come from `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_BASE_URL=http://localhost:3000
# Public tunnel URL that Twilio calls (changes when the Cloudflare tunnel restarts). Phase 2+.
PUBLIC_BASE_URL=

# Adapters and engine (Phase 2+)
ADAPTER_MODE=real
ENABLE_DEV_ENDPOINTS=false
WORKER_SECRET=
WORKER_URL=http://localhost:3000/api/worker
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

# Twilio (Phase 3+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_NUMBER=
# Trial accounts only (Console "Try out WhatsApp"): the pre-approved template SID, HX...
TWILIO_TRIAL_CONTENT_SID=

# OpenAI (Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=

# Resend (Phase 4+)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Calendar. Redirect URI for local use: http://localhost:3000/api/integrations/google/callback
# ENCRYPTION_KEY above: generate with `openssl rand -base64 32`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
